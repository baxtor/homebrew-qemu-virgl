--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -675,8 +675,17 @@
     if (display_opengl) {
 #ifdef CONFIG_OPENGL
         [self.glLayer setContentsScale:[[self window] backingScaleFactor]];
+        /*
+         * The scanout layers must track the view, not the guest scanout size.
+         * dpy_gl_scanout_texture() only fires on guest mode changes, so without
+         * this a window resize leaves the layer at its old, guest-sized frame:
+         * part of the view is left uncovered (stale/white rectangles) and
+         * zoom-to-fit / full-screen cannot scale.
+         */
+        [self.glLayer setFrame:[self bounds]];
 #ifdef USE_METAL
         [self.metalLayer setContentsScale:[[self window] backingScaleFactor]];
+        [self.metalLayer setFrame:[self bounds]];
 #endif
 #endif
     } else {
@@ -1320,7 +1329,14 @@
         CGFloat scale = self.window.backingScaleFactor;
         self.metalLayer.contentsScale = scale;
         self.metalLayer.pixelFormat = metalTexture.pixelFormat;
-        self.metalLayer.frame = CGRectMake(0, 0, size.width / scale, size.height / scale);
+        /*
+         * Fill the view and let Core Animation scale the drawable: drawFrame's
+         * blitCommandEncoder copy cannot scale, so sizing the layer to the guest
+         * resolution would leave the rest of the window uncovered.
+         */
+        self.metalLayer.frame = self.bounds;
+        self.metalLayer.magnificationFilter =
+            qatomic_read(&zoom_interpolation) ? kCAFilterLinear : kCAFilterNearest;
         self.metalLayer.drawableSize = CGSizeMake(size.width, size.height);
         self.scanout = QemuCocoaViewScanoutMetal;
     }
@@ -2415,7 +2431,12 @@
         dispatch_async(dispatch_get_main_queue(), ^{
             CGFloat scale = cocoaView.window.backingScaleFactor;
             cocoaView.glLayer.contentsScale = scale;
-            cocoaView.glLayer.frame = CGRectMake(0, 0, w / scale, h / scale);
+            /*
+             * cocoa_gl_render() sets the viewport from the view frame and blits
+             * with a filter, so the layer (and thus the EGL surface) must cover
+             * the view -- not the guest scanout -- or the two disagree.
+             */
+            cocoaView.glLayer.frame = cocoaView.bounds;
             cocoaView.scanout = QemuCocoaViewScanoutGL;
         });
     }
